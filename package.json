{
  "name": "broccoli-battle",
  "version": "1.0.0",
  "private": true,
  "description": "Fruit. Veg. Glory. A family game about eating your five-a-day.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
