# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (or any Postgres).
# Leave unset in local development to use an embedded PGlite database stored
# in .data/pglite — the whole game works without any external database.
DATABASE_URL=

# ── First-run setup ─────────────────────────────────────────────────────────
# Required to run the one-time household setup wizard at /setup.
# Generate one with: openssl rand -hex 24
BOOTSTRAP_TOKEN=

# Secret used for signing/misc hashing. Generate: openssl rand -hex 32
APP_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
HOUSEHOLD_TIMEZONE=Europe/London

# ── Artwork (Level 2 — optional) ────────────────────────────────────────────
# Vercel Blob read-write token. Without it, foods use their emoji placeholder.
BLOB_READ_WRITE_TOKEN=

# ── AI (Levels 2 & 3 — optional) ───────────────────────────────────────────
# Without an OpenAI key the app still works completely: food classification
# falls back to a built-in heuristic, artwork falls back to emoji characters,
# and the weekly battle report falls back to a templated commentary system.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-5-mini
